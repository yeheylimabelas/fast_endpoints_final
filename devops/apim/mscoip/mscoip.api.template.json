{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "ApimServiceName": {
      "type": "string"
    },
    "BackEndUrl": {
      "type": "string"
    },
    "LinkedTemplatesUrlQueryString": {
      "type": "string"
    },
    "PolicyXMLBaseUrl": {
      "type": "string"
    }
  },
  "resources": [
    {
      "properties": {
        "isCurrent": true,
        "subscriptionRequired": true,
        "displayName": "FAS-MSCOIP",
        "path": "fas/mscoip",
        "protocols": [
          "https"
        ],
        "value": "[concat(parameters('BackEndUrl'), '/swagger/v1/swagger.json')]",
        "format": "openapi-link"
      },
      "name": "[concat(parameters('ApimServiceName'), '/fas-mscoip')]",
      "type": "Microsoft.ApiManagement/service/apis",
      "apiVersion": "2021-01-01-preview",
      "dependsOn": []
    },
    {
      "properties": {
        "value": "[concat(parameters('PolicyXMLBaseUrl'), '/Backend-Policy.xml', parameters('LinkedTemplatesUrlQueryString'))]",
        "format": "rawxml-link"
      },
      "name": "[concat(parameters('ApimServiceName'), '/fas-mscoip/policy')]",
      "type": "Microsoft.ApiManagement/service/apis/policies",
      "apiVersion": "2021-01-01-preview",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('ApimServiceName'), 'fas-mscoip')]"
      ]
    },
    {
      "name": "[concat(parameters('ApimServiceName'), '/FAS-COIP/fas-mscoip')]",
      "type": "Microsoft.ApiManagement/service/products/apis",
      "apiVersion": "2021-01-01-preview",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('ApimServiceName'), 'fas-mscoip')]"
      ]
    }
  ]
}
